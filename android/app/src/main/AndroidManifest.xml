<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 局域网：发现用组播/广播，传输与聊天走 HTTP。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
        组播/广播收包的总开关：没有它，安卓的 Wi-Fi 省电逻辑会把"目的地址不是本机"
        的组播/广播帧直接丢掉 —— 电脑端每 30 秒一次的公告根本进不来，只能靠 TCP 主动
        扫描兜底。这是"安卓端不能自动发现"的第二个原因（第一个是启动时压根没扫）。
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- 前台服务：熄屏、切后台也保持连接，这正是做原生 App 的原因。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
        常驻长连接用 specialUse 类型。原因：Android 15 起 dataSync 类型的前台
        服务有「每 24 小时累计 6 小时」配额，到点系统强制 onTimeout 停服 ——
        和"只有手动断开才断"的产品语义直接冲突（真机是 Android 16，会命中）。
        specialUse 无时长配额，对"用户显式开启的局域网长连接"也更准确。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 语音消息。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 下载到公共目录（Android 9 及以下）。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".EverSendApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.EverSend">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".LinkService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <!-- specialUse 类型必须声明用途（Android 14+ 的清单要求）。 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户在设置页开启的局域网常驻连接：熄屏/切后台时保持与电脑的消息长连接与文件传输" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
