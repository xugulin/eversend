# ---- 构建产物与下载缓存 ------------------------------------------------
# 便携包 zip 有 130 MB，运行时解压有 372 MB，绝不能进仓库
tools/.build/
tools/.build-*/
tools/.cache/

# ---- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境。⚠️ 不写结尾斜杠：`.venv/` 只忽略目录**内容**，忽略不掉 `.venv`
# 这个软链本身，而本机的 .venv 正是指向别处的软链。
.venv
venv/

# ---- 本机运行痕迹 ------------------------------------------------------
data/
received/
.testscratch/
*.eversend.part
*.eversend.journal

# ---- 编辑器 ------------------------------------------------------------
.vscode/
.idea/
*.swp
